# ---------------------------------------------------------------------------
# Secrets and environment files -- never commit.
# Patterns are broad on purpose: .gitignore is the first line of defence, and
# .githooks/pre-commit blocks these even if forced with `git add -f`.
# ---------------------------------------------------------------------------
.env
.env.*
*.env
.envrc
.Renviron
.Rprofile
*.pem
*.key
secrets.*
credentials.*

# Claude Code session/local files -- never commit. Project-level CLAUDE.md
# (repo root) is tracked deliberately; other CLAUDE.*.md variants (local
# notes, session exports) stay ignored.
CLAUDE.*.md
**/CLAUDE.*.md
.claude/
.claude*

# Data is never committed
data/

# Rendered IAM/S3 policies carry the real AWS account id and bucket name.
# Only the <ACCOUNT_ID>/<BUCKET> placeholder templates are tracked.
infra/*.json
!infra/*.json.example

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# macOS
.DS_Store
