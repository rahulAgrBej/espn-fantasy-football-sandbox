#!/bin/sh
# Block secrets and Claude instruction files from ever being committed.
#
# .gitignore is advisory -- it does nothing for `git add -f` or for a file that
# is already tracked. This hook is the enforcement layer.
#
# Enable (once per clone):  git config core.hooksPath .githooks

set -u

FORBIDDEN='(^|/)\.env($|\.)|\.env$|(^|/)\.envrc$|(^|/)\.Renviron$|(^|/)\.Rprofile$|(^|/)[Cc][Ll][Aa][Uu][Dd][Ee]([.-][^/]*)?\.[Mm][Dd]$|(^|/)\.claude(/|$)|\.pem$|\.key$|(^|/)secrets\.|(^|/)credentials\.'

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

offenders=$(printf '%s\n' "$staged" | grep -E "$FORBIDDEN" || true)

if [ -n "$offenders" ]; then
    echo >&2
    echo "BLOCKED: refusing to commit environment or Claude instruction files." >&2
    echo >&2
    printf '%s\n' "$offenders" | sed 's/^/    /' >&2
    echo >&2
    echo "These may hold credentials or local-only instructions and must stay" >&2
    echo "out of version control. To unstage:" >&2
    echo >&2
    printf '%s\n' "$offenders" | sed 's/^/    git restore --staged /' >&2
    echo >&2
    exit 1
fi

# The Odds API key is metered -- unlike ESPN's cookies, leaking it has a
# real dollar cost. Scan added lines only (not the whole file, so an
# already-committed match elsewhere in history never re-triggers this) for
# an `ODDS_API_KEY=<value>` assignment with a plausible key-shaped value (16+
# alnum chars, so a doc's own placeholder text like `ODDS_API_KEY=<value>`
# or an empty `ODDS_API_KEY=` in .env.example never false-positives) or a
# bare 32-hex-character key.
added_lines=$(git diff --cached -U0 -- . ':(exclude).githooks/pre-commit' | grep -E '^\+[^+]' || true)
key_hit=$(printf '%s\n' "$added_lines" | grep -E "ODDS_API_KEY[[:space:]]*=[[:space:]]*['\"]?[0-9A-Za-z_-]{16,}" || true)
hex_hit=$(printf '%s\n' "$added_lines" | grep -E '(^|[^0-9a-fA-F])[0-9a-fA-F]{32}([^0-9a-fA-F]|$)' || true)

if [ -n "$key_hit" ] || [ -n "$hex_hit" ]; then
    echo >&2
    echo "BLOCKED: a staged change looks like it contains an Odds API key." >&2
    echo >&2
    [ -n "$key_hit" ] && printf '%s\n' "$key_hit" | sed 's/^/    /' >&2
    [ -n "$hex_hit" ] && printf '%s\n' "$hex_hit" | sed 's/^/    /' >&2
    echo >&2
    echo "ODDS_API_KEY is metered -- it must never land in a commit. Remove the" >&2
    echo "key (or the file holding it) from the staged change and retry." >&2
    echo >&2
    exit 1
fi

exit 0
